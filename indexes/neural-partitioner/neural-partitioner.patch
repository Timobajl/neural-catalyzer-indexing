+++ b/np_scripts/np_bigann.sh
@@ -0,0 +1,90 @@
+#!/bin/bash
+#PBS -l select=1:ncpus=32:mem=20gb:scratch_ssd=10gb:cluster=halmir
+#PBS -l walltime=12:00:00
