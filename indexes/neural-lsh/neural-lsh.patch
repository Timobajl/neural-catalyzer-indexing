+def nearest_local_graph_neighbor(data, row_idx, opt=None):
+    """
+    Return a 1-based nearest-neighbor ID for a point whose parent-graph
+    neighbors all left the partition, using the metric of the run.
+    """
+    metric_name = getattr(opt, 'metric_name', None)
+    if metric_name is None or metric_name == 'l2':
+        local_ranks = utils.dist_rank(data[row_idx].unsqueeze(0), k=1, data_y=data, opt=opt)
+        return local_ranks[0][0].item() + 1
+
+    if metric_name == 'ip':
+        if len(data) <= 1:
+            raise ValueError('Cannot add a fallback graph edge with fewer than two points.')
+        data_work = data.to(utils.device)
+        query = data_work[row_idx].unsqueeze(0)
+        scores = torch.mm(query, data_work.t()).view(-1)
+        scores[row_idx] = -float('inf')
+        nearest_idx = int(torch.argmax(scores).item())
+        return nearest_idx + 1
+
+    raise ValueError('Unsupported metric_name for local graph fallback: {}'.format(metric_name))
+
