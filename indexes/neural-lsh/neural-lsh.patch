+def soft_label_neighbor_count(opt):
+    """
+    Number of neighbor ranks for the soft labels: ``soft_label_neighbors`` if set,
+    otherwise the original ``nn_mult * k``.
+    """
+    explicit = getattr(opt, 'soft_label_neighbors', None)
+    if explicit is not None:
+        return max(1, int(explicit))
+    return max(1, int(opt.nn_mult * opt.k))
+
+def model_data_name(opt):
+    """
+    Dataset name for saved files: ``model_data_name`` if set, otherwise derived
+    from the dataset flags.
+    """
+    if getattr(opt, 'model_data_name', None):
+        return opt.model_data_name
+    if opt.sift:
+        return 'sift'
+    if opt.glove:
+        return 'glove'
+    if opt.prefix10m:
+        return 'prefix10m'
+    return 'mnist'
+
+def next_bucket_base(opt, width):
+    """
+    Allocate a contiguous range of final bucket IDs.
+
+    The original code used the number of non-empty buckets as the next base ID,
+    which reuses an ID once a leaf has an empty class.
+    """
+    base = getattr(opt, '_next_bucket_id', 0)
+    opt._next_bucket_id = base + width
+    return base
+
+def raw_ip_dist_rank(data, k):
+    """
+    Return top-k raw inner-product neighbors within ``data``, excluding self.
+
+    This is only used when ``opt.metric_name == 'ip'``, a child node trains a
+    neural network, and it cannot reuse enough global precomputed ranks.  L2 uses
+    the original ``utils.dist_rank`` instead.
+    """
+    if len(data) <= 1:
+        return torch.empty((len(data), 0), dtype=torch.long, device=data.device)
+
+    original_device = data.device
+    data = data.to(utils.device)
+    data_len = data.size(0)
+    k_eff = min(int(k), data_len - 1)
+    result = torch.empty((data_len, k_eff), dtype=torch.long, device=data.device)
+
+    chunk_sz = 90 if data_len > 990000 else 3000
+    data_t = data.t()
+    search_k = min(k_eff + 1, data_len)
+    for base in range(0, data_len, chunk_sz):
+        upto = min(base + chunk_sz, data_len)
+        scores = torch.mm(data[base:upto], data_t)
+        topk = torch.topk(scores, k=search_k, dim=1, largest=True)[1]
+        for local_row, global_row in enumerate(range(base, upto)):
+            row = topk[local_row]
+            row = row[row != global_row]
+            if row.numel() < k_eff:
+                pad = torch.full(
+                    (k_eff - row.numel(),),
+                    global_row,
+                    dtype=torch.long,
+                    device=data.device,
+                )
+                row = torch.cat((row, pad))
+            result[global_row] = row[:k_eff]
+        del scores
+
+    return result.to(original_device)
+
+def local_soft_label_ranks(dataset, ds_idx, n_neighbors, opt):
+    """
+    Exact soft-label ranks within a node, in the metric of the run.
+    """
+    metric_name = getattr(opt, 'metric_name', None)
+    if metric_name is None or metric_name == 'l2':
+        return utils.dist_rank(dataset[ds_idx], k=n_neighbors, opt=opt)
+    if metric_name == 'ip':
+        return raw_ip_dist_rank(dataset[ds_idx], k=n_neighbors)
+    raise ValueError('Unsupported metric_name for local soft-label ranks: {}'.format(metric_name))
+
+def soft_label_ranks(dataset, ds_idx, opt):
+    """
+    Neighbor ranks for the soft-label training of a node.
+
+    The root reuses the ranks precomputed by ``nlsh_index.py``. A child reuses them
+    only if every point keeps enough neighbors inside the child, otherwise it
+    computes them locally.
+    """
+    n_neighbors = soft_label_neighbor_count(opt)
+    ranks_path = getattr(opt, 'ranks_path', None)
+
+    if ranks_path and getattr(opt, 'use_precomputed_soft_labels', False):
+        global_ranks = np.load(ranks_path, mmap_mode='r')
+        if global_ranks.shape[1] < n_neighbors:
+            raise ValueError(
+                'Precomputed ranks depth {} is smaller than soft_label_neighbors {}.'.format(
+                    global_ranks.shape[1], n_neighbors
+                )
+            )
+        ds_idx_np = ds_idx.cpu().numpy() if isinstance(ds_idx, torch.Tensor) else np.asarray(ds_idx)
+        if len(ds_idx_np) == global_ranks.shape[0] and np.array_equal(ds_idx_np, np.arange(len(ds_idx_np))):
+            return torch.from_numpy(np.asarray(global_ranks[:, :n_neighbors], dtype=np.int64))
+
+        # Translate global neighbor IDs to the local IDs of this child.
+        global_to_local = {int(global_id): local_id for local_id, global_id in enumerate(ds_idx_np)}
+        local_ranks = np.empty((len(ds_idx_np), n_neighbors), dtype=np.int64)
+        for local_row, global_id in enumerate(ds_idx_np):
+            found = []
+            for neighbor in global_ranks[int(global_id)]:
+                local_neighbor = global_to_local.get(int(neighbor))
+                if local_neighbor is not None and local_neighbor != local_row:
+                    found.append(local_neighbor)
+                    if len(found) == n_neighbors:
+                        break
+            if len(found) < min(n_neighbors, len(ds_idx_np) - 1):
+                print(
+                    'Precomputed global ranks are too shallow for a child node; '
+                    'falling back to exact local soft-label ranks with metric {}.'.format(
+                        getattr(opt, 'metric_name', 'legacy')
+                    )
+                )
+                break
+            local_ranks[local_row, :len(found)] = found
+            if len(found) < n_neighbors:
+                local_ranks[local_row, len(found):] = local_row
+        else:
+            return torch.from_numpy(local_ranks)
+
+    # No usable precomputed ranks.
+    return local_soft_label_ranks(dataset, ds_idx, n_neighbors, opt)
+
