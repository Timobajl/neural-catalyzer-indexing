+
+TARGET_ORIG="$SCRATCHDIR/original"
+TARGET="$SCRATCHDIR/bigann${DIM}"
+WORK_DIR="$SCRATCHDIR/nlsh_work"
+
+export OMP_NUM_THREADS=$PBS_NUM_PPN
+export MKL_NUM_THREADS=$PBS_NUM_PPN
+
+mkdir -p "$OUTPUT_DIR"
+
+module add mambaforge
+
